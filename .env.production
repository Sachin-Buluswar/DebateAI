# Production Environment Variables
# CRITICAL: These settings secure your production deployment

# ============================================
# SECURITY - MUST BE SET TO FALSE IN PRODUCTION
# ============================================
ENABLE_DEBUG_ENDPOINT=false
ENABLE_SQL_ENDPOINT=false
NODE_ENV=production

# Debug API keys - Leave empty in production
DEBUG_API_KEY=
ADMIN_SQL_KEY=

# ============================================
# DATABASE - Required
# ============================================
NEXT_PUBLIC_SUPABASE_URL=your_production_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key

# ============================================
# EXTERNAL APIS - Required
# ============================================
OPENAI_API_KEY=your_production_openai_key
ELEVENLABS_API_KEY=your_production_elevenlabs_key
OPENAI_VECTOR_STORE_ID=your_production_vector_store_id

# ============================================
# SITE CONFIGURATION
# ============================================
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
ALLOWED_ORIGINS=https://your-production-domain.com

# ============================================
# OPTIONAL CONFIGURATION
# ============================================
# ElevenLabs specific models (optional)
ELEVENLABS_STT_MODEL_ID=
ELEVENLABS_CROSSFIRE_AGENT_ID=

# Port (usually not needed on Vercel)
# PORT=3000

# ============================================
# MONITORING (Optional but recommended)
# ============================================
# Sentry DSN for error tracking
# SENTRY_DSN=your_sentry_dsn

# ============================================
# NOTES
# ============================================
# 1. Replace all "your_production_*" values with actual keys
# 2. NEVER commit this file to version control
# 3. Ensure ENABLE_DEBUG_ENDPOINT and ENABLE_SQL_ENDPOINT are false
# 4. Set NODE_ENV=production
# 5. Update ALLOWED_ORIGINS with your actual domain